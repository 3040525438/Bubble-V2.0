#!/bin/sh
# 泡泡 Bubble V2.0 — 提交前敏感信息检查（pre-commit hook）
# 启用方式：git config core.hooksPath .githooks
# 命中以下任一规则将拒绝提交：
#   1. DeepSeek/OpenAI 风格 API Key（sk- 开头长串）
#   2. PEM 私钥块
#   3. 明文令牌（Bearer 长串 / api_key 赋值长串）
#   4. 禁止入库的文件类型（.db/.p12/.ipa/.env 等）
# 注意：正则全部使用单引号包裹且不含单引号字符，避免 sh 解析断裂。

FAIL=0

DIFF=$(git diff --cached --diff-filter=ACMR -U0)

HIT=$(printf '%s\n' "$DIFF" | grep -InE 'sk-[A-Za-z0-9]{16,}')
[ -n "$HIT" ] && { printf '%s\n' "$HIT"; FAIL=1; }

HIT=$(printf '%s\n' "$DIFF" | grep -InE 'BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY')
[ -n "$HIT" ] && { printf '%s\n' "$HIT"; FAIL=1; }

HIT=$(printf '%s\n' "$DIFF" | grep -InE 'Bearer [A-Za-z0-9_.-]{25,}')
[ -n "$HIT" ] && { printf '%s\n' "$HIT"; FAIL=1; }

HIT=$(printf '%s\n' "$DIFF" | grep -InE '[Aa]pi[_-]?[Kk]ey["=: ]*[A-Za-z0-9]{20,}')
[ -n "$HIT" ] && { printf '%s\n' "$HIT"; FAIL=1; }

if [ "$FAIL" = "1" ]; then
  echo "============================================"
  echo "[pre-commit] 检测到疑似敏感信息（见上方行号），已拒绝提交。"
  echo "  如为误报（如文档示例），请调整写法后重试；"
  echo "  真实密钥请录入 App Keychain 或本机环境变量，绝不入库。"
  echo "============================================"
  exit 1
fi

# 文件类型黑名单
FILES=$(git diff --cached --name-only --diff-filter=ACMR)
while IFS= read -r f; do
  case "$f" in
    *.db|*.db-shm|*.db-wal|*.sqlite|*.sqlite3|*.sqlite-wal|*.p12|*.pfx|*.pem|*.key|*.keystore|*.jks|*.mobileprovision|*.ipa|*.cer|*.crt)
      echo "[pre-commit] 禁止入库的文件类型: $f"
      FAIL=1
      ;;
    .env)
      echo "[pre-commit] 环境配置文件禁止入库: .env（仅允许 .env.example 占位）"
      FAIL=1
      ;;
    *.env)
      case "$f" in
        .env.example) ;;
        *) echo "[pre-commit] 环境配置文件禁止入库: $f（仅允许 .env.example 占位）"; FAIL=1 ;;
      esac
      ;;
  esac
done <<EOF
$FILES
EOF

if [ "$FAIL" = "1" ]; then
  echo "============================================"
  echo "[pre-commit] 提交被拒绝，请处理上述问题后重试。"
  echo "============================================"
  exit 1
fi

exit 0
