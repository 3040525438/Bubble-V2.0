#!/bin/sh
# 泡泡 Bubble V2.0 — 提交前敏感信息检查（pre-commit hook）
# 启用方式：git config core.hooksPath .githooks
# 命中以下任一规则将拒绝提交：
#   1. DeepSeek/OpenAI 风格 API Key（sk- 开头长串）
#   2. PEM 私钥块
#   3. 明文令牌赋值（Bearer 长串 / token= 长串）
#   4. 禁止入库的二进制/敏感文件类型（.db/.p12/.ipa 等）

FAIL=0

# 规则 1~3：内容扫描（仅扫描暂存的文本差异）
if git diff --cached --diff-filter=ACMR -U0 | grep -InE \
   'sk-[A-Za-z0-9]{16,}|BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY|Bearer [A-Za-z0-9_\-.]{25,}|[Aa]pi[_-]?[Kk]ey["'"'"' ]*[:=]["'"'"' ]*[A-Za-z0-9]{20,}'; then
  echo "============================================"
  echo "[pre-commit] 检测到疑似敏感信息（见上方行号），已拒绝提交。"
  echo "  如为误报（如文档示例），请调整写法后重试；"
  echo "  真实密钥请录入 App Keychain 或本机环境变量，绝不入库。"
  echo "============================================"
  FAIL=1
fi

# 规则 4：文件类型黑名单
for f in $(git diff --cached --name-only --diff-filter=ACMR); do
  case "$f" in
    *.db|*.db-shm|*.db-wal|*.sqlite*|*.p12|*.pfx|*.pem|*.key|*.keystore|*.jks|*.mobileprovision|*.ipa|*.cer|*.crt)
      echo "[pre-commit] 禁止入库的文件类型: $f"
      FAIL=1
      ;;
    .env|*.env)
      case "$f" in
        .env.example) ;;  # 占位示例允许
        *) echo "[pre-commit] 环境配置文件禁止入库: $f（仅允许 .env.example 占位）"; FAIL=1 ;;
      esac
      ;;
  esac
done

exit $FAIL
